<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <!-- JForum 2.7.0 Upgrade Changelog -->
    <!-- Migration from version 2.6.2 to 2.7.0 -->
    
    <changeSet id="jforum-2.7.0-01-add-skype-column" author="jforum">
        <comment>Add Skype ID column to users table</comment>
        <addColumn tableName="jforum_users">
            <column name="user_skype" type="VARCHAR(50)" defaultValue="">
                <constraints nullable="true"/>
            </column>
        </addColumn>
        <rollback>
            <dropColumn tableName="jforum_users" columnName="user_skype"/>
        </rollback>
    </changeSet>
    
    <changeSet id="jforum-2.7.0-02-remove-obsolete-user-columns" author="jforum">
        <comment>Remove obsolete instant messaging and visibility columns from users table</comment>
        <dropColumn tableName="jforum_users" columnName="user_viewonline"/>
        <dropColumn tableName="jforum_users" columnName="user_allow_viewonline"/>
        <dropColumn tableName="jforum_users" columnName="user_aim"/>
        <dropColumn tableName="jforum_users" columnName="user_yim"/>
        <dropColumn tableName="jforum_users" columnName="user_msnm"/>
        
        <rollback>
            <addColumn tableName="jforum_users">
                <column name="user_viewonline" type="INT" defaultValueNumeric="1"/>
                <column name="user_allow_viewonline" type="INT" defaultValueNumeric="1"/>
                <column name="user_aim" type="VARCHAR(50)"/>
                <column name="user_yim" type="VARCHAR(50)"/>
                <column name="user_msnm" type="VARCHAR(50)"/>
            </addColumn>
        </rollback>
    </changeSet>
    
    <changeSet id="jforum-2.7.0-03-widen-config-value-field" author="jforum">
        <comment>Widen config value field for long entries</comment>
        <modifyDataType tableName="jforum_config" columnName="config_value" newDataType="VARCHAR(1024)"/>
        <rollback>
            <modifyDataType tableName="jforum_config" columnName="config_value" newDataType="VARCHAR(255)"/>
        </rollback>
    </changeSet>
    
